# ── 构建产物 ─────────────────────────────────────────────
/target/
**/target/
*.rlib
*.pdb

# ── 编译出的可执行文件（不入库，由 CI/本地自行构建）──────
/AICraftLauncher.exe

# ── 运行期数据（便携数据目录，含日志与设置）──────────────
/AICraftData/
*.log

# ── 手工试装服务端时留在仓库根的文件（fabric 安装器的产物）────
/libraries/
/fabric-server-launch.jar

# ── 图标生成的预览图（只给人看，不参与构建）──────────────
/tools/logo-preview/

# ── 编辑器 / 系统杂项 ─────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
